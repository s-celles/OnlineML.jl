# Allowlist policy: ignore everything unless explicitly admitted below.
*

# Package metadata and project documentation
!/.gitignore
!/.JuliaFormatter.toml
!/LICENSE
!/Project.toml
!/README.md
!/upstream-bugs.md

# Continuous integration
!/.github/
!/.github/**

# Julia package sources and extensions
!/src/
!/src/**/
!/src/**/*.jl
!/ext/
!/ext/**/
!/ext/**/*.jl

# Tests
!/test/
!/test/**/
!/test/**/*.jl

# Documentation sources (generated docs/build and docs/site remain ignored)
!/docs/
!/docs/Project.toml
!/docs/make.jl
!/docs/src/
!/docs/src/**/
!/docs/src/**/*.md

# Examples
!/examples/
!/examples/*.jl

# Benchmarks and checked-in reference results
!/benchmark/
!/benchmark/*.jl
!/benchmark/*.py
!/benchmark/*.txt

# Local specification and architecture artifacts
/spec.md
/ROADMAP.md
/.specify/
/specs/
/docs/src/juliaai_audit.md
/docs/src/juliaai_ears_supplement.md
